# Copy to .env on the server (never commit .env)
PUBLIC_HOST=boldoc.in
# random string; generate with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
M0_KEY=change-me
ECHO_DELAY_MS=600
# set e.g. 25 to auto-close the stream after 25 s (tests <Redirect> without DTMF)
AUTO_CLOSE_S=0
# talker
STREAM_KEY=change-me
TALKER_LLM=sarvam-105b
TALKER_VOICE=kavya_hi_conversational
# enforce | log (verify + log only, for rollout) | off
VALIDATE_PLIVO_SIGNATURES=enforce
# control plane (documents, SMS, link pages)
# random strings; generate each with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
INTERNAL_KEY=change-me
PG_PASSWORD=change-me
# the SMS sender: your Plivo number or DLT header
SMS_SRC=
SMS_ENABLED=1
DIAL_IN_E164=+918035449833
THINKER_WORKERS=2
# admin console host names, comma-separated (Caddy serves it there; control's /admin/api answers only there)
ADMIN_HOSTS=admin.boldoc.in
# the number signed-in users see and Call me rings from (unset: DIAL_IN_E164); the public pages show DIAL_IN_E164
MEMBER_DIAL_IN_E164=+918035449820
